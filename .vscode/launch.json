{
    "version": "1.0.0",
    "configurations": [
        {
            "name": "Debug SurfSander",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/surfsander/cli.py",
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/test/input/doi_voxelisation.npz",
                "--output-dir", "${workspaceFolder}/test/output",
                "--voxel-size", "0.005",
                "--k1-max", "140",
                "--k2-max", "70",
            ]
        }
    ]
}